# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Downloaded releases, graph/distance matrices and generated evaluation outputs.
/data/
/core/ranking/artifacts/

# Local Python environments, build products and caches.
.venv/
/.venv-ranking/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]
*.egg-info/

# Local credentials; keep the example environment template available to Git.
.env
/.env.*
!/.env.example
/.aws/
/secrets/

# Assembled by deploy/vercel/build.py
.vercel-deploy/

# Generated by core/discovery_pipeline/pipeline.py (written to the directory it runs from).
/core/discovery_pipeline/pipeline_state.json
/core/discovery_pipeline/structures/
/core/discovery_pipeline/agent[0-9]_output.json
/core/discovery_pipeline/review.md
/core/discovery_pipeline/review.json
/core/discovery_pipeline/results.md
/core/discovery_pipeline/final_paper.md
