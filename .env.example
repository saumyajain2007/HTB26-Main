# Copy to .env and fill in. Never commit .env.
# Wrap JSON values in single quotes.

# --- Data sources --------------------------------------------------------------
# fixture | live (run `uv run python -m htb_api.prepare` first)
HTB_SOURCE=fixture
# fixture | mock | cortex
HTB_JURY=fixture
# fixture | vina (needs HTB_REPO=postgres; see app/worker/README.md)
# HTB_DOCKING=vina

# --- Sessions and rate limits --------------------------------------------------
# Set true behind an HTTPS proxy.
# HTB_SESSION_COOKIE_SECURE=true
HTB_REQUESTS_PER_MINUTE=240
HTB_WRITES_PER_MINUTE=30
HTB_MAX_ACTIVE_REQUESTS=32
HTB_EXPERIMENTS_PER_HOUR=6
HTB_EXPERIMENTS_PER_DAY=100
HTB_JURY_PER_HOUR=3
HTB_CORTEX_CALLS_PER_MINUTE=12
HTB_CORTEX_CALLS_PER_DAY=180

# --- Snowflake Cortex (HTB_JURY=cortex) -------------------------------------
# Account is the part before .snowflakecomputing.com; PAT is a programmatic access token.
# Models, e.g. '["openai-gpt-5.4","glm-5.3","kimi-k3"]'
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
SNOWFLAKE_MODELS=
SNOWFLAKE_REASONING_EFFORT='{}'

# --- Postgres (optional; memory is the default) --------------------------------
# Migrate first: uv run deploy/db/migrate.py
# HTB_REPO=postgres
# DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
